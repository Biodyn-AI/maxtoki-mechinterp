{
  "$schema_note": "Curated hematopoietic stage DAG for the H65 biological ruler. Sources: Laurenti & Göttgens 2018 (hematopoietic landscape review), Paul et al. 2015 (myeloid lineage heterogeneity), Velten et al. 2017 (hematopoietic continuum). Used to derive hematopoietic stage labels from Tabula Sapiens immune cell_type / free_annotation strings. The 'distance' between two anchors with stages s_i, s_j is the unweighted graph shortest-path on this DAG (treating it as undirected for distance). Anchors whose cell_type maps to null are excluded from the H65 panel (they remain in the dataset for use in unrelated phases).",
  "committed_on": "2026-05-03",
  "stage_to_branch": {
    "HSC":        {"branch": "stem",          "depth": 0},
    "MPP":        {"branch": "stem",          "depth": 1},
    "CMP":        {"branch": "myeloid",       "depth": 2},
    "GMP":        {"branch": "granulocyte",   "depth": 3},
    "MEP":        {"branch": "erythroid",     "depth": 3},
    "CLP":        {"branch": "lymphoid",      "depth": 2},
    "Pro_B":      {"branch": "B_lineage",     "depth": 3},
    "Pre_B":      {"branch": "B_lineage",     "depth": 4},
    "Naive_B":    {"branch": "B_lineage",     "depth": 5},
    "Memory_B":   {"branch": "B_lineage",     "depth": 6},
    "Plasma":     {"branch": "B_lineage",     "depth": 7},
    "DN_T":       {"branch": "T_lineage",     "depth": 3},
    "DP_T":       {"branch": "T_lineage",     "depth": 4},
    "Naive_CD4":  {"branch": "T_lineage",     "depth": 5},
    "Memory_CD4": {"branch": "T_lineage",     "depth": 6},
    "Naive_CD8":  {"branch": "T_lineage",     "depth": 5},
    "Memory_CD8": {"branch": "T_lineage",     "depth": 6},
    "Treg":       {"branch": "T_lineage",     "depth": 6},
    "MAIT":       {"branch": "T_lineage",     "depth": 6},
    "gd_T":       {"branch": "T_lineage",     "depth": 5},
    "ILC":        {"branch": "lymphoid",      "depth": 5},
    "NK":         {"branch": "NK",            "depth": 5},
    "Pro_Mono":   {"branch": "monocyte",      "depth": 4},
    "Cl_Mono":    {"branch": "monocyte",      "depth": 5},
    "NC_Mono":    {"branch": "monocyte",      "depth": 6},
    "Macrophage": {"branch": "macrophage",    "depth": 7},
    "Dendritic":  {"branch": "dendritic",     "depth": 5},
    "pDC":        {"branch": "dendritic",     "depth": 5},
    "Neutrophil": {"branch": "granulocyte",   "depth": 5},
    "Basophil":   {"branch": "granulocyte",   "depth": 5},
    "Eosinophil": {"branch": "granulocyte",   "depth": 5},
    "Mast":       {"branch": "granulocyte",   "depth": 5},
    "Erythrocyte":{"branch": "erythroid",     "depth": 6},
    "Platelet":   {"branch": "megakaryocyte", "depth": 6}
  },
  "edges": [
    ["HSC","MPP"],
    ["MPP","CMP"], ["MPP","CLP"],
    ["CMP","GMP"], ["CMP","MEP"], ["CMP","Pro_Mono"],
    ["GMP","Neutrophil"], ["GMP","Basophil"], ["GMP","Eosinophil"], ["GMP","Mast"],
    ["MEP","Erythrocyte"], ["MEP","Platelet"],
    ["Pro_Mono","Cl_Mono"], ["Cl_Mono","NC_Mono"], ["Cl_Mono","Macrophage"], ["Cl_Mono","Dendritic"], ["Cl_Mono","pDC"],
    ["CLP","Pro_B"], ["Pro_B","Pre_B"], ["Pre_B","Naive_B"], ["Naive_B","Memory_B"], ["Memory_B","Plasma"], ["Naive_B","Plasma"],
    ["CLP","DN_T"], ["DN_T","DP_T"], ["DP_T","Naive_CD4"], ["DP_T","Naive_CD8"], ["DP_T","gd_T"],
    ["Naive_CD4","Memory_CD4"], ["Naive_CD4","Treg"], ["Memory_CD4","MAIT"],
    ["Naive_CD8","Memory_CD8"], ["Memory_CD8","MAIT"],
    ["CLP","ILC"], ["ILC","NK"]
  ],
  "cell_type_to_stage": {
    "$$comment": "Maps Tabula Sapiens immune `cell_type` and `free_annotation` strings to the stage codes above. Match precedence: free_annotation > cell_type. Lowercase comparison. Null mapping = excluded from H65 panel.",
    "naive thymus-derived cd4-positive, alpha-beta t cell": "Naive_CD4",
    "cd4-positive, alpha-beta t cell": "Memory_CD4",
    "cd4-positive, alpha-beta memory t cell": "Memory_CD4",
    "cd4-positive helper t cell": "Memory_CD4",
    "regulatory t cell": "Treg",
    "naive thymus-derived cd8-positive, alpha-beta t cell": "Naive_CD8",
    "cd8-positive, alpha-beta t cell": "Memory_CD8",
    "cd8-positive, alpha-beta memory t cell": "Memory_CD8",
    "cd8-positive, alpha-beta cytokine secreting effector t cell": "Memory_CD8",
    "double-positive, alpha-beta thymocyte": "DP_T",
    "double negative thymocyte": "DN_T",
    "mucosal invariant t cell": "MAIT",
    "gamma-delta t cell": "gd_T",
    "t cell": "Memory_CD4",
    "thymocyte": "DN_T",
    "mature alpha-beta t cell": "Memory_CD4",
    "innate lymphoid cell": "ILC",
    "natural killer cell": "NK",
    "type i nk t cell": "NK",
    "b cell": "Naive_B",
    "naive b cell": "Naive_B",
    "memory b cell": "Memory_B",
    "class switched memory b cell": "Memory_B",
    "transitional stage b cell": "Pre_B",
    "plasma cell": "Plasma",
    "plasmablast": "Plasma",
    "plasmacytoid dendritic cell": "pDC",
    "conventional dendritic cell": "Dendritic",
    "dendritic cell": "Dendritic",
    "myeloid dendritic cell": "Dendritic",
    "cd1c-positive myeloid dendritic cell": "Dendritic",
    "cd141-positive myeloid dendritic cell": "Dendritic",
    "monocyte": "Cl_Mono",
    "classical monocyte": "Cl_Mono",
    "non-classical monocyte": "NC_Mono",
    "intermediate monocyte": "Cl_Mono",
    "macrophage": "Macrophage",
    "alveolar macrophage": "Macrophage",
    "tissue-resident macrophage": "Macrophage",
    "kupffer cell": "Macrophage",
    "microglial cell": "Macrophage",
    "elicited macrophage": "Macrophage",
    "neutrophil": "Neutrophil",
    "mature neutrophil": "Neutrophil",
    "basophil": "Basophil",
    "eosinophil": "Eosinophil",
    "mast cell": "Mast",
    "erythrocyte": "Erythrocyte",
    "erythroid lineage cell": "Erythrocyte",
    "erythroid progenitor cell": "MEP",
    "platelet": "Platelet",
    "megakaryocyte": "Platelet",
    "hematopoietic stem cell": "HSC",
    "hematopoietic precursor cell": "MPP",
    "common myeloid progenitor": "CMP",
    "common lymphoid progenitor": "CLP",
    "granulocyte monocyte progenitor cell": "GMP",
    "lymphocyte": null,
    "leukocyte": null,
    "blood cell": null,
    "$$exclusions": "stromal/epithelial/etc. mappings stay null (not in this list)"
  }
}
